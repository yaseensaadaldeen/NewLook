@using Microsoft.Extensions.Options
@using NEWLOOK.Models.NewLook
@model NEWLOOK.Models.NewLook.Team
@inject IOptions<ImageSettings> ImgSettings

@{
    var maxSizeMb = ImgSettings.Value.MaxImageSizeInMB;
    ViewData["Title"] = "Edit Team Member";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="about section pt-2 pt-md-5">
    <div class="container">
        <h1>Edit Team Member</h1>
        <hr />
        <div class="signup-border">
            <form asp-action="Edit" enctype="multipart/form-data">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group">
                    <label asp-for="EmpName" class="control-label"></label>
                    <input asp-for="EmpName" class="form-control" />
                </div>
                <div class="form-group">
                    <label asp-for="EmpSkills" class="control-label"></label>
                    <input asp-for="EmpSkills" class="form-control" />
                </div>
                <div class="form-group">
                    <label asp-for="Nationality" class="control-label"></label>
                    <input asp-for="Nationality" class="form-control" />
                </div>
                <div class="form-group">
                    <label asp-for="Experiances" class="control-label"></label>
                    <input asp-for="Experiances" class="form-control" />
                </div>
                <div class="form-group">
                    <label asp-for="Languages" class="control-label"></label>
                    <input asp-for="Languages" class="form-control" />
                </div>
                <div class="form-group">
                    <label asp-for="CountryWork" class="control-label"></label>
                    <input asp-for="CountryWork" class="form-control" />
                </div>
                <div class="form-group">
                    <label class="control-label">Update Profile Image</label>
                    <input type="file" name="imageFile" class="form-control" />
                    @if (!string.IsNullOrEmpty(Model.ImageLink))
                    {
                        <p>Current Image:</p>
                        <img src="@Model.ImageLink" width="150" />
                    }
                </div>

                <div class="form-group">
                    <label asp-for="Active" class="control-label"></label>
                    <select asp-for="Active" class="form-control">
                        <option value="Y">Active</option>
                        <option value="N">Inactive</option>
                    </select>
                </div>

                <div class="form-group">
                    <input type="submit" value="Save Changes" class="btn btn-primary" />
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
